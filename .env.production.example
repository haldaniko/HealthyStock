# Copy to .env.production before running docker-compose.prod.yml.
# This file is read by Docker Compose for variable substitution.

POSTGRES_DB=healthystock
POSTGRES_USER=healthystock
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

LOCAL_SUPERADMIN_EMAIL=admin@healthystock.example
LOCAL_SUPERADMIN_PASSWORD=replace-with-a-long-random-admin-password

VITE_API_URL=https://yourdomain.com
VITE_GA_MEASUREMENT_ID=
