# Production template. `npm run setup:prod-env` creates the single root .env.
# Keep the existing PostgreSQL credentials unchanged during the SQLite migration.

COMPOSE_PROJECT_NAME=

POSTGRES_DB=healthystock
POSTGRES_USER=healthystock
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

LOCAL_SUPERADMIN_EMAIL=admin@healthystock.example
LOCAL_SUPERADMIN_PASSWORD=replace-with-a-long-random-admin-password

VITE_API_URL=https://yourdomain.com
VITE_GA_MEASUREMENT_ID=

PORT=4000
NODE_ENV=production
CORS_ORIGIN=https://yourdomain.com
DATABASE_URL=sqlite:/host/db.sqlite3
REDIS_URL=redis://redis:6379
PUBLIC_SITE_URL=https://yourdomain.com
BOT_INTEGRATION_TOKEN=

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_TIMEOUT_MS=45000
OPENROUTER_MAX_INPUT_CHARS=16000
OPENROUTER_MAX_OUTPUT_TOKENS=2200
OPENROUTER_TEMPERATURE=0.7
OPENROUTER_SITE_URL=https://yourdomain.com
OPENROUTER_APP_NAME=HealthyStock

JWT_SECRET=
REFRESH_TOKEN_SECRET=
REFRESH_COOKIE_DOMAIN=
REFRESH_COOKIE_SAMESITE=lax
TRUST_PROXY=true

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="HealthyStock <newsletter@yourdomain.com>"
