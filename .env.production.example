# Copy to .env.production before the first deployment. Keep the existing
# PostgreSQL credentials unchanged during the SQLite migration.

POSTGRES_DB=healthystock
POSTGRES_USER=healthystock
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

LOCAL_SUPERADMIN_EMAIL=admin@healthystock.example
LOCAL_SUPERADMIN_PASSWORD=replace-with-a-long-random-admin-password

VITE_API_URL=https://yourdomain.com
VITE_GA_MEASUREMENT_ID=
